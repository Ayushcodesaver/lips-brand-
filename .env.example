# Copy to .env.local and fill in — see SETUP.md for step-by-step instructions.

# Clerk (dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex (printed by `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=

# Cosmetic: hides the sandbox hint in checkout when set to `production`
NEXT_PUBLIC_CASHFREE_MODE=sandbox
